[Unit]
Description=Feishu bot - Moyuzai AI assistant
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/agents/feishu-bot
EnvironmentFile=/data/agents/feishu-bot/.env
ExecStart=/usr/bin/python3 /data/agents/feishu-bot/feishu_bot.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
